{
  "name": "paletscan-etl",
  "version": "1.0.0",
  "description": "ETL Pipeline & Web Scraper suite for PaletScan data ingestion",
  "main": "dist/index.js",
  "scripts": {
    "scrape:friboi": "npx tsx scrapers/friboi/index.ts",
    "scrape:seara": "npx tsx scrapers/seara/index.ts",
    "scrape:brf": "npx tsx scrapers/brf/index.ts",
    "scrape:aurora": "npx tsx scrapers/aurora/index.ts",
    "scrape:lar": "npx tsx scrapers/lar/index.ts",
    "scrape:copacol": "npx tsx scrapers/copacol/index.ts",
    "scrape:all": "npx tsx scrapers/friboi/index.ts && npx tsx scrapers/seara/index.ts && npx tsx scrapers/brf/index.ts && npx tsx scrapers/aurora/index.ts && npx tsx scrapers/lar/index.ts && npx tsx scrapers/copacol/index.ts",
    "sync:supabase": "npx tsx db_sync/sync.ts",
    "sync:images": "npx tsx db_sync/sync_images.ts",
    "sanitize": "npx tsx db_sync/sanitize_supabase_db.ts",
    "export:pwa": "npx tsx scripts/generate_pwa_produtos_json.ts",
    "export:excel": "npx tsx scripts/export_excel.ts",
    "audit": "npx tsx scripts/audit_database.ts",
    "status": "npx tsx scripts/check_status.ts",
    "help:manifest": "npx tsx scripts/render_help_from_manifest.ts",
    "wipe": "npx tsx db_sync/wipe_db_only.ts",
    "validate:mermaid": "node scripts/validate_mermaid.js",
    "full": "npx tsx scripts/run_full_pipeline.ts",
    "build": "tsc"
  },
  "keywords": [
    "etl",
    "scraper",
    "friboi",
    "paletscan",
    "supabase",
    "data-ingestion",
    "rembg",
    "storage"
  ],
  "author": "PaletScan Data Team",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
